# ─── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=your-telegram-bot-token
ADMIN_BOT_TOKEN=your-admin-telegram-bot-token

# ─── LLM Provider ────────────────────────────────────────────────────────────
# One of: openrouter | groq | gemini | ollama | claude
LLM_PROVIDER=openrouter

# Anthropic / Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-5

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=your-preferred-model

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=your-preferred-model

# Google Gemini (AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local / self-hosted)
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=your-local-model

# ─── Odoo Connection ─────────────────────────────────────────────────────────
ODOO_URL=https://odoo.example.com
ODOO_DB=your-database-name
ODOO_VERSION=18

# ─── Report Branding (all optional — neutral defaults apply) ─────────────────
BRAND_COMPANY_NAME=ACME
BRAND_COMPANY_SUBTITLE=Ltd.
BRAND_COMPANY_TAGLINE=Business Automation
BRAND_SIGNATURE_NAME=Jane Doe
BRAND_SIGNATURE_COMPANY=ACME Ltd.
BRAND_SIGNATURE_ADDRESS=123 Example Street, Example City
BRAND_SIGNATURE_EMAIL=contact@example.com
BRAND_SIGNATURE_PHONE=+1 (555) 010-0000
